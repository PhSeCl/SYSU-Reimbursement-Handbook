  \end{minipage}\hfill
  \begin{minipage}[b]{.17\linewidth}\raggedleft
    {\rmfamily\mdseries\color{BookPurple}\fontsize{88}{88}\selectfont #2\par}
  \end{minipage}\par\vspace{12mm}}
